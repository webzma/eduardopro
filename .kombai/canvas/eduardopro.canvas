    "var_93eaba9ba05f": {
      "type": "variant",
      "label": "EduardoPro — Editorial",
      "parentId": null,
      "themeId": null,
      "rect": {
        "x": 1540,
        "y": 0,
        "w": 1440,
        "h": 800
      },
      "html": "<div class=\"antialiased\" data-kid=\"1\" data-name=\"page layout container\" style=\"background:#F3EBE2;color:#1A1A1A;font-family:'Inter',sans-serif;\">\n    <style>\n        @import url('https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,300;0,400;0,500;1,300;1,400&family=Inter:wght@300;400;500;600&family=IBM+Plex+Mono:wght@400;500&display=swap');\n    .font-serif{font-family:'Playfair Display',serif;}\n    .font-mono{font-family:'IBM Plex Mono',monospace;}\n    .label{font-family:'IBM Plex Mono',monospace;text-transform:uppercase;letter-spacing:0.18em;font-size:12px;}\n    .reveal{opacity:0;transform:translateY(28px);}\n    .reveal.in{opacity:1;transform:translateY(0);transition:opacity 1s cubic-bezier(.16,1,.3,1),transform 1s cubic-bezier(.16,1,.3,1);}\n    .hairline{background:#C5BEB6;}\n    .prod-panel{background:linear-gradient(180deg,#FBF7F2,#EFE6DB);}\n    input,textarea{font-family:'Inter',sans-serif;}\n    .btn-fill:hover{background:#c07f5b;}\n    .link-ul{position:relative;}\n    .link-ul::after{content:\"\";position:absolute;left:0;bottom:-4px;height:1px;width:0;background:currentColor;transition:width .4s ease;}\n    .link-ul:hover::after{width:100%;}\n    </style>\n    <!-- NAVBAR -->\n    <header class=\"sticky top-0 z-50\" data-kid=\"1-1\" data-name=\"navigation bar container\" style=\"background:#F3EBE2;border-bottom:1px solid #C5BEB6;\">\n        <nav class=\"max-w-[1440px] mx-auto px-6 md:px-16 h-20 flex items-center justify-between\" data-kid=\"1-1-1\" data-name=\"navbar layout container\">\n            <a class=\"font-serif tracking-tight\" data-kid=\"1-1-1-1\" data-name=\"logo link text\" href=\"#\" style=\"font-size:26px;\">\n                EduardoPro\n            </a>\n            <ul class=\"hidden md:flex items-center gap-10 label\" data-kid=\"1-1-1-2\" data-name=\"main navigation list\" style=\"color:#3D3D3D;\">\n                <li data-kid=\"1-1-1-2-1\" data-name=\"oficio navigation item\">\n                    <a class=\"link-ul\" data-kid=\"1-1-1-2-1-1\" data-name=\"oficio link\" href=\"#oficio\">\n                        El Oficio\n                    </a>\n                </li>\n                <li data-kid=\"1-1-1-2-2\" data-name=\"colección navigation item\">\n                    <a class=\"link-ul\" data-kid=\"1-1-1-2-2-1\" data-name=\"colección link\" href=\"#coleccion\">\n                        Colección\n                    </a>\n                </li>\n                <li data-kid=\"1-1-1-2-3\" data-name=\"testimonios navigation item\">\n                    <a class=\"link-ul\" data-kid=\"1-1-1-2-3-1\" data-name=\"testimonios link\" href=\"#testimonios\">\n                        Testimonios\n                    </a>\n                </li>\n            </ul>\n            <a class=\"label px-5 py-3 text-white btn-fill\" data-kid=\"1-1-1-3\" data-name=\"contact call-to-action button\" href=\"#contacto\" style=\"background:#1A1A1A;border-radius:4px;\">\n                Contacto\n            </a>\n        </nav>\n    </header>\n    <!-- HERO -->\n    <section class=\"relative min-h-[85vh] flex flex-col justify-between overflow-hidden\" data-kid=\"1-2\" data-name=\"hero section\">\n        <img alt=\"Barbería\" class=\"absolute inset-0 w-full h-full object-cover\" data-kid=\"1-2-1\" data-name=\"hero background image\" decoding=\"async\" loading=\"lazy\" src=\"https://images.unsplash.com/photo-1633121050918-ab208f1508b7?auto=format&w=1600&q=80&fit=crop\"/>\n        <div class=\"absolute inset-0\" data-kid=\"1-2-2\" data-name=\"hero gradient overlay\" style=\"background:linear-gradient(180deg,rgba(20,20,20,.45) 0%,rgba(20,20,20,.15) 28%,rgba(20,20,20,.35) 55%,rgba(20,20,20,.92) 100%);\">\n        </div>\n        <div class=\"relative max-w-[1440px] w-full mx-auto px-6 md:px-16 pt-8 flex items-center justify-between gap-4 text-white/80\" data-kid=\"1-2-3\" data-name=\"hero top meta container\">\n            <span class=\"label\" data-kid=\"1-2-3-1\" data-name=\"business founding date label\">\n                Est. 2020 — Suministros de Barbería\n            </span>\n            <span class=\"label hidden sm:block\" data-kid=\"1-2-3-2\" data-name=\"shipping information label\">\n                Envíos a todo el país\n            </span>\n        </div>\n        <div class=\"relative max-w-[1440px] w-full mx-auto px-6 md:px-16 pb-16 md:pb-20 text-white\" data-kid=\"1-2-4\" data-name=\"hero content container\">\n            <p class=\"label mb-6 reveal\" data-kid=\"1-2-4-1\" data-name=\"hero category label\" style=\"color:#D4916E;\">\n                Herramientas · Cuidado · Ritual\n            </p>\n            <h1 class=\"font-serif font-light leading-[0.9] reveal\" data-kid=\"1-2-4-2\" data-name=\"hero headline text\" style=\"font-size:clamp(64px,11vw,130px);\">\n                EduardoPro\n            </h1>\n            <p class=\"reveal mt-8 max-w-[520px] text-white/85 font-light\" data-kid=\"1-2-4-3\" data-name=\"hero description text\" style=\"font-size:18px;line-height:1.65;\">\n                Herramientas profesionales y cuidado premium para el ritual diario del caballero. Directo del distribuidor a tu silla.\n            </p>\n            <div class=\"reveal mt-10 flex flex-wrap items-center gap-4\" data-kid=\"1-2-4-4\" data-name=\"hero buttons container\">\n                <a class=\"label px-7 py-4 btn-fill\" data-kid=\"1-2-4-4-1\" data-name=\"explore collection primary button\" href=\"#coleccion\" style=\"background:#D4916E;color:#1A1A1A;border-radius:4px;\">\n                    Explorar Colección\n                </a>\n                <a class=\"label px-7 py-4 border border-white/70 text-white hover:bg-white hover:text-black transition-colors\" data-kid=\"1-2-4-4-2\" data-name=\"contact secondary button\" href=\"#contacto\" style=\"border-radius:4px;\">\n                    Hablar con nosotros\n                </a>\n            </div>\n        </div>\n    </section>\n    <!-- TRUST STRIP -->\n    <section data-kid=\"1-3\" data-name=\"trust strip section\" style=\"background:#1A1A1A;\">\n        <div class=\"max-w-[1440px] mx-auto px-6 md:px-16 py-6 flex flex-wrap items-center justify-center gap-x-8 gap-y-3 text-center\" data-kid=\"1-3-1\" data-name=\"trust items container\">\n            <span class=\"label\" data-kid=\"1-3-1-1\" data-name=\"quality guarantee label\" style=\"color:#F3EBE2;\">\n                Calidad Garantizada\n            </span>\n            <span class=\"hairline w-px h-4 hidden md:inline-block\" data-kid=\"1-3-1-2\" data-name=\"hairline divider\" style=\"opacity:.4;\">\n            </span>\n            <span class=\"label\" data-kid=\"1-3-1-3\" data-name=\"fast shipping label\" style=\"color:#F3EBE2;\">\n                Envío en 24 Horas\n            </span>\n            <span class=\"hairline w-px h-4 hidden md:inline-block\" data-kid=\"1-3-1-4\" data-name=\"hairline divider\" style=\"opacity:.4;\">\n            </span>\n            <span class=\"label\" data-kid=\"1-3-1-5\" data-name=\"expert advice label\" style=\"color:#F3EBE2;\">\n                Asesoría Experta\n            </span>\n            <span class=\"hairline w-px h-4 hidden md:inline-block\" data-kid=\"1-3-1-6\" data-name=\"hairline divider\" style=\"opacity:.4;\">\n            </span>\n            <span class=\"label\" data-kid=\"1-3-1-7\" data-name=\"secure payment label\" style=\"color:#F3EBE2;\">\n                Pago Seguro\n            </span>\n        </div>\n    </section>\n    <!-- EL OFICIO -->\n    <section class=\"max-w-[1440px] mx-auto px-6 md:px-16 py-24 md:py-32\" data-kid=\"1-4\" data-name=\"about section\" id=\"oficio\">\n        <div class=\"grid md:grid-cols-2 gap-12 md:gap-20 items-start\" data-kid=\"1-4-1\" data-name=\"about grid layout container\">\n            <div class=\"reveal\" data-kid=\"1-4-1-1\" data-name=\"about text content container\">\n                <p class=\"label mb-5\" data-kid=\"1-4-1-1-1\" data-name=\"about category label\" style=\"color:#D4916E;\">\n                    El Oficio\n                </p>\n                <h2 class=\"font-serif font-light leading-tight\" data-kid=\"1-4-1-1-2\" data-name=\"about main headline\" style=\"font-size:clamp(38px,5vw,52px);\">\n                    El oficio, bien hecho\n                </h2>\n                <p class=\"mt-7 max-w-[480px] font-light\" data-kid=\"1-4-1-1-3\" data-name=\"about description text\" style=\"color:#3D3D3D;font-size:17px;line-height:1.7;\">\n                    Compramos directo a distribuidores. Tú recibes precio de barbería y productos que aguantan el día a día en la silla. Sin intermediarios, sin ruido, con criterio.\n                </p>\n                <div class=\"mt-12\" data-kid=\"1-4-1-1-4\" data-name=\"about features list container\">\n                    <div class=\"hairline h-px w-full\" data-kid=\"1-4-1-1-4-1\" data-name=\"hairline divider\">\n                    </div>\n                    <div class=\"py-7 flex gap-6\" data-kid=\"1-4-1-1-4-2\" data-name=\"feature 1 container\">\n                        <span class=\"font-mono text-lg shrink-0\" data-kid=\"1-4-1-1-4-2-1\" data-name=\"feature 1 index\" style=\"color:#D4916E;\">\n                            01\n                        </span>\n                        <div data-kid=\"1-4-1-1-4-2-2\" data-name=\"feature 1 text block\">\n                            <h3 class=\"font-serif\" data-kid=\"1-4-1-1-4-2-2-1\" data-name=\"feature 1 title\" style=\"font-size:22px;\">\n                                Calidad garantizada\n                            </h3>\n                            <p class=\"mt-2 font-light\" data-kid=\"1-4-1-1-4-2-2-2\" data-name=\"feature 1 description\" style=\"color:#3D3D3D;font-size:15px;line-height:1.6;\">\n                                Marcas probadas y seleccionadas para el trabajo profesional diario.\n                            </p>\n                        </div>\n                    </div>\n                    <div class=\"hairline h-px w-full\" data-kid=\"1-4-1-1-4-3\" data-name=\"hairline divider\">\n                    </div>\n                    <div class=\"py-7 flex gap-6\" data-kid=\"1-4-1-1-4-4\" data-name=\"feature 2 container\">\n                        <span class=\"font-mono text-lg shrink-0\" data-kid=\"1-4-1-1-4-4-1\" data-name=\"feature 2 index\" style=\"color:#D4916E;\">\n                            02\n                        </span>\n                        <div data-kid=\"1-4-1-1-4-4-2\" data-name=\"feature 2 text block\">\n                            <h3 class=\"font-serif\" data-kid=\"1-4-1-1-4-4-2-1\" data-name=\"feature 2 title\" style=\"font-size:22px;\">\n                                Envío en 24 horas\n                            </h3>\n                            <p class=\"mt-2 font-light\" data-kid=\"1-4-1-1-4-4-2-2\" data-name=\"feature 2 description\" style=\"color:#3D3D3D;font-size:15px;line-height:1.6;\">\n                                Despacho rápido a todo el país para que nunca te falte nada.\n                            </p>\n                        </div>\n                    </div>\n                    <div class=\"hairline h-px w-full\" data-kid=\"1-4-1-1-4-5\" data-name=\"hairline divider\">\n                    </div>\n                    <div class=\"py-7 flex gap-6\" data-kid=\"1-4-1-1-4-6\" data-name=\"feature 3 container\">\n                        <span class=\"font-mono text-lg shrink-0\" data-kid=\"1-4-1-1-4-6-1\" data-name=\"feature 3 index\" style=\"color:#D4916E;\">\n                            03\n                        </span>\n                        <div data-kid=\"1-4-1-1-4-6-2\" data-name=\"feature 3 text block\">\n                            <h3 class=\"font-serif\" data-kid=\"1-4-1-1-4-6-2-1\" data-name=\"feature 3 title\" style=\"font-size:22px;\">\n                                Asesoría experta\n                            </h3>\n                            <p class=\"mt-2 font-light\" data-kid=\"1-4-1-1-4-6-2-2\" data-name=\"feature 3 description\" style=\"color:#3D3D3D;font-size:15px;line-height:1.6;\">\n                                Te orientamos para elegir la herramienta correcta según tu silla.\n                            </p>\n                        </div>\n                    </div>\n                    <div class=\"hairline h-px w-full\" data-kid=\"1-4-1-1-4-7\" data-name=\"hairline divider\">\n                    </div>\n                </div>\n            </div>\n            <div class=\"reveal md:pt-4\" data-kid=\"1-4-1-2\" data-name=\"about media container\">\n                <div class=\"relative\" data-kid=\"1-4-1-2-1\" data-name=\"about figure container\">\n                    <img alt=\"Detalle barbería\" class=\"w-full h-[560px] md:h-[720px] object-cover\" data-kid=\"1-4-1-2-1-1\" data-name=\"about detail image\" decoding=\"async\" loading=\"lazy\" src=\"https://images.unsplash.com/photo-1503951914875-452162b0f3f1?auto=format&w=900&q=80&fit=crop\"/>\n                    <span class=\"label absolute bottom-5 left-5 text-white/90\" data-kid=\"1-4-1-2-1-2\" data-name=\"about figure caption\">\n                        Fig. 01 — El taller\n                    </span>\n                </div>\n            </div>\n        </div>\n    </section>\n    <!-- COLECCIÓN -->\n    <section data-kid=\"1-5\" data-name=\"collection section\" id=\"coleccion\" style=\"background:#EDE3D8;border-top:1px solid #C5BEB6;border-bottom:1px solid #C5BEB6;\">\n        <div class=\"max-w-[1440px] mx-auto px-6 md:px-16 py-24 md:py-32\" data-kid=\"1-5-1\" data-name=\"collection content wrapper\">\n            <div class=\"flex flex-col md:flex-row md:items-end md:justify-between gap-6 mb-16 reveal\" data-kid=\"1-5-1-1\" data-name=\"collection header container\">\n                <div data-kid=\"1-5-1-1-1\" data-name=\"collection title group\">\n                    <p class=\"label mb-5\" data-kid=\"1-5-1-1-1-1\" data-name=\"collection category label\" style=\"color:#D4916E;\">\n                        Colección\n                    </p>\n                    <h2 class=\"font-serif font-light leading-tight\" data-kid=\"1-5-1-1-1-2\" data-name=\"collection headline\" style=\"font-size:clamp(38px,5vw,56px);\">\n                        La colección\n                    </h2>\n                </div>\n                <p class=\"label max-w-[280px]\" data-kid=\"1-5-1-1-2\" data-name=\"collection subheadline description\" style=\"color:#3D3D3D;\">\n                    Selección esencial — herramientas y cuidado para el profesional.\n                </p>\n            </div>\n            <div class=\"grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4\" data-kid=\"1-5-1-2\" data-name=\"products grid container\" style=\"border-top:1px solid #C5BEB6;border-left:1px solid #C5BEB6;\">\n                <!-- card -->\n                <article class=\"reveal group p-6 flex flex-col\" data-kid=\"1-5-1-2-1\" data-name=\"product card 1\" style=\"border-right:1px solid #C5BEB6;border-bottom:1px solid #C5BEB6;\">\n                    <div class=\"prod-panel aspect-square flex items-center justify-center overflow-hidden mb-6\" data-kid=\"1-5-1-2-1-1\" data-name=\"product card image wrapper\">\n                        <img alt=\"Máquina Wahl\" class=\"w-full h-full object-contain p-3 group-hover:scale-105 transition-transform duration-700\" data-kid=\"1-5-1-2-1-1-1\" data-name=\"product 1 image\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/products/maquina-wahl.png\"/>\n                    </div>\n                    <p class=\"label mb-2\" data-kid=\"1-5-1-2-1-2\" data-name=\"product 1 category label\" style=\"color:#3D3D3D;\">\n                        Máquina profesional\n                    </p>\n                    <h3 class=\"font-serif\" data-kid=\"1-5-1-2-1-3\" data-name=\"product 1 title\" style=\"font-size:24px;\">\n                        Máquina Wahl\n                    </h3>\n                    <p class=\"mt-1 font-light\" data-kid=\"1-5-1-2-1-4\" data-name=\"product 1 description\" style=\"color:#3D3D3D;font-size:14px;\">\n                        Corte preciso y potente\n                    </p>\n                    <div class=\"mt-auto pt-6 flex items-center justify-between\" data-kid=\"1-5-1-2-1-5\" data-name=\"product 1 purchase footer\">\n                        <span class=\"font-serif\" data-kid=\"1-5-1-2-1-5-1\" data-name=\"product 1 price\" style=\"color:#D4916E;font-size:22px;\">\n                            $85\n                        </span>\n                        <a class=\"label link-ul\" data-kid=\"1-5-1-2-1-5-2\" data-name=\"product 1 whatsapp link\" href=\"#contacto\">\n                            Pedir por WhatsApp\n                        </a>\n                    </div>\n                </article>\n                <article class=\"reveal group p-6 flex flex-col\" data-kid=\"1-5-1-2-2\" data-name=\"product card 2\" style=\"border-right:1px solid #C5BEB6;border-bottom:1px solid #C5BEB6;\">\n                    <div class=\"prod-panel aspect-square flex items-center justify-center overflow-hidden mb-6\" data-kid=\"1-5-1-2-2-1\" data-name=\"product card image wrapper\">\n                        <img alt=\"Cera Rolda\" class=\"w-full h-full object-contain p-3 group-hover:scale-105 transition-transform duration-700\" data-kid=\"1-5-1-2-2-1-1\" data-name=\"product 2 image\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/products/cera-rolda.png\"/>\n                    </div>\n                    <p class=\"label mb-2\" data-kid=\"1-5-1-2-2-2\" data-name=\"product 2 category label\" style=\"color:#3D3D3D;\">\n                        Cera de peinado mate\n                    </p>\n                    <h3 class=\"font-serif\" data-kid=\"1-5-1-2-2-3\" data-name=\"product 2 title\" style=\"font-size:24px;\">\n                        Cera Rolda\n                    </h3>\n                    <p class=\"mt-1 font-light\" data-kid=\"1-5-1-2-2-4\" data-name=\"product 2 description\" style=\"color:#3D3D3D