      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500&family=Inter:wght@300;400;500;600&family=IBM+Plex+Mono:wght@400;500&display=swap');\n\n  .font-display { font-family: 'Playfair Display', serif; }\n  .font-body { font-family: 'Inter', sans-serif; }\n  .font-mono { font-family: 'IBM Plex Mono', monospace; }\n\n  .ep-surface { background-color: #F3EBE2; }\n  .ep-ink { color: #1A1A1A; }\n  .ep-ink-soft { color: #3D3D3D; }\n  .ep-accent { color: #D4916E; }\n  .ep-bg-accent { background-color: #D4916E; }\n  .ep-bg-ink { background-color: #1A1A1A; }\n  .ep-border { border-color: #C5BEB6; }\n\n  .mono-label {\n    font-family: 'IBM Plex Mono', monospace;\n    text-transform: uppercase;\n    letter-spacing: 0.22em;\n    font-size: 0.7rem;\n  }\n\n  .reveal { opacity: 0; transform: translateY(34px); transition: opacity 1s cubic-bezier(.16,.84,.44,1), transform 1s cubic-bezier(.16,.84,.44,1); }\n  .reveal.in { opacity: 1; transform: none; }\n\n  .btn-accent { background-color: #D4916E; color: #1A1A1A; transition: background-color .35s ease, transform .35s ease; }\n  .btn-accent:hover { background-color: #c17d59; transform: translateY(-2px); }\n\n  .btn-ink { background-color: #1A1A1A; color: #F3EBE2; transition: background-color .35s ease, transform .35s ease; }\n  .btn-ink:hover { background-color: #000; transform: translateY(-2px); }\n\n  .link-underline { position: relative; }\n  .link-underline::after { content:''; position:absolute; left:0; bottom:-3px; height:1px; width:100%; background:#1A1A1A; transform:scaleX(0); transform-origin:left; transition:transform .4s ease; }\n  .link-underline:hover::after { transform:scaleX(1); }\n\n  .prod-panel { transition: transform .5s cubic-bezier(.16,.84,.44,1); }\n  .prod-panel:hover { transform: translateY(-6px); }\n\n  .field { background:#fff; border:1px solid #C5BEB6; transition:border-color .3s ease; }\n  .field:focus { outline:none; border-color:#D4916E; }\n</style>\n<div class=\"ep-surface font-body ep-ink antialiased overflow-x-clip\" data-kid=\"1\" data-name=\"page layout container\">\n    <!-- ================= NAVBAR ================= -->\n    <header class=\"ep-surface/90 sticky top-0 z-50 backdrop-blur-sm border-b ep-border\" data-kid=\"1-1\" data-name=\"navbar container\">\n        <nav class=\"max-w-[1240px] mx-auto px-6 lg:px-10 h-20 flex items-center justify-between\" data-kid=\"1-1-1\" data-name=\"navigation bar\">\n            <a class=\"font-display text-2xl font-600 tracking-tight ep-ink\" data-kid=\"1-1-1-1\" data-name=\"brand logo text\" href=\"#\">\n                EduardoPro\n            </a>\n            <div class=\"hidden md:flex items-center gap-10 mono-label ep-ink-soft\" data-kid=\"1-1-1-2\" data-name=\"navigation menu links\">\n                <a class=\"hover:ep-accent transition-colors\" data-kid=\"1-1-1-2-1\" data-name=\"navigation link\" href=\"#oficio\">\n                    El Oficio\n                </a>\n                <a class=\"hover:ep-accent transition-colors\" data-kid=\"1-1-1-2-2\" data-name=\"navigation link\" href=\"#coleccion\">\n                    Colección\n                </a>\n                <a class=\"hover:ep-accent transition-colors\" data-kid=\"1-1-1-2-3\" data-name=\"navigation link\" href=\"#testimonios\">\n                    Testimonios\n                </a>\n            </div>\n            <a class=\"btn-ink mono-label px-6 py-3 rounded-full\" data-kid=\"1-1-1-3\" data-name=\"contact call-to-action button\" href=\"#contacto\">\n                Contacto\n            </a>\n        </nav>\n    </header>\n    <!-- ================= HERO ================= -->\n    <section class=\"max-w-[1240px] mx-auto px-6 lg:px-10 pt-16 lg:pt-24 pb-20\" data-kid=\"1-2\" data-name=\"hero section\">\n        <div class=\"grid lg:grid-cols-12 gap-10 lg:gap-14 items-center\" data-kid=\"1-2-1\" data-name=\"hero content grid\">\n            <div class=\"lg:col-span-7 reveal\" data-kid=\"1-2-1-1\" data-name=\"hero text column\">\n                <p class=\"mono-label ep-accent mb-8\" data-kid=\"1-2-1-1-1\" data-name=\"hero section label\">\n                    Herramientas · Cuidado · Ritual\n                </p>\n                <h1 class=\"font-display font-500 ep-ink leading-[0.98] text-[clamp(2.6rem,6vw,5.1rem)] tracking-tight\" data-kid=\"1-2-1-1-2\" data-name=\"hero main headline\">\n                    Cuidado premium\n                    <br data-kid=\"1-2-1-1-2-1\" data-name=\"line break\"/>\n                    para el\n                    <span class=\"italic ep-accent\" data-kid=\"1-2-1-1-2-2\" data-name=\"hero headline italic highlight\">\n                        caballero\n                    </span>\n                    moderno\n                </h1>\n                <p class=\"ep-ink-soft text-lg max-w-md mt-8 leading-relaxed font-300\" data-kid=\"1-2-1-1-3\" data-name=\"hero description text\">\n                    Productos de barbería seleccionados uno a uno. Precio directo, calidad que aguanta la silla y envíos a todo el país.\n                </p>\n                <div class=\"flex flex-wrap items-center gap-7 mt-10\" data-kid=\"1-2-1-1-4\" data-name=\"hero buttons container\">\n                    <a class=\"btn-accent mono-label px-8 py-4 rounded-full\" data-kid=\"1-2-1-1-4-1\" data-name=\"explore collection button\" href=\"#coleccion\">\n                        Explorar Colección\n                    </a>\n                    <a class=\"link-underline font-mono text-sm ep-ink\" data-kid=\"1-2-1-1-4-2\" data-name=\"whatsapp call-to-action link\" href=\"#contacto\">\n                        Hablar por WhatsApp →\n                    </a>\n                </div>\n                <div class=\"mt-14 inline-flex items-center gap-3 border ep-border rounded-full px-5 py-2.5\" data-kid=\"1-2-1-1-5\" data-name=\"shipping status banner\">\n                    <span class=\"w-2 h-2 rounded-full ep-bg-accent\" data-kid=\"1-2-1-1-5-1\" data-name=\"status indicator dot\">\n                    </span>\n                    <span class=\"mono-label ep-ink-soft\" data-kid=\"1-2-1-1-5-2\" data-name=\"shipping status text\">\n                        Envíos a todo el país\n                    </span>\n                </div>\n            </div>\n            <div class=\"lg:col-span-5 reveal relative\" data-kid=\"1-2-1-2\" data-name=\"hero image column\">\n                <div class=\"absolute -top-5 -left-5 w-full h-full border-2 rounded-[2rem]\" data-kid=\"1-2-1-2-1\" data-name=\"hero image decorative border\" style=\"border-color:#D4916E;\">\n                </div>\n                <div class=\"relative rounded-[2rem] overflow-hidden\" data-kid=\"1-2-1-2-2\" data-name=\"hero image container\">\n                    <img alt=\"Barbería\" class=\"w-full h-[440px] lg:h-[560px] object-cover\" data-kid=\"1-2-1-2-2-1\" data-name=\"hero banner image\" decoding=\"async\" loading=\"lazy\" src=\"https://images.unsplash.com/photo-1599351431202-1e0f0137899a?auto=format&w=1000&q=80&fit=crop\"/>\n                </div>\n                <div class=\"absolute -bottom-6 left-8 bg-white ep-border border rounded-2xl px-6 py-4\" data-kid=\"1-2-1-2-3\" data-name=\"hero stats banner\">\n                    <p class=\"font-display text-2xl ep-ink\" data-kid=\"1-2-1-2-3-1\" data-name=\"stats count text\">\n                        +2.000\n                    </p>\n                    <p class=\"mono-label ep-ink-soft mt-1\" data-kid=\"1-2-1-2-3-2\" data-name=\"stats label text\">\n                        Pedidos entregados\n                    </p>\n                </div>\n            </div>\n        </div>\n    </section>\n    <!-- ================= TRUST STRIP ================= -->\n    <section class=\"border-y ep-border\" data-kid=\"1-3\" data-name=\"trust strip section\">\n        <div class=\"max-w-[1240px] mx-auto px-6 lg:px-10\" data-kid=\"1-3-1\" data-name=\"trust strip container\">\n            <div class=\"grid grid-cols-2 md:grid-cols-4 divide-x divide-y md:divide-y-0 ep-border\" data-kid=\"1-3-1-1\" data-name=\"trust items grid\" style=\"border-color:#C5BEB6;\">\n                <div class=\"py-7 px-6 text-center mono-label ep-ink-soft border-b ep-border md:border-b-0\" data-kid=\"1-3-1-1-1\" data-name=\"trust item\">\n                    Calidad Garantizada\n                </div>\n                <div class=\"py-7 px-6 text-center mono-label ep-ink-soft border-b ep-border md:border-b-0\" data-kid=\"1-3-1-1-2\" data-name=\"trust item\">\n                    Envío en 24 Horas\n                </div>\n                <div class=\"py-7 px-6 text-center mono-label ep-ink-soft\" data-kid=\"1-3-1-1-3\" data-name=\"trust item\">\n                    Asesoría Experta\n                </div>\n                <div class=\"py-7 px-6 text-center mono-label ep-ink-soft\" data-kid=\"1-3-1-1-4\" data-name=\"trust item\">\n                    Pago Seguro\n                </div>\n            </div>\n        </div>\n    </section>\n    <!-- ================= EL OFICIO ================= -->\n    <section class=\"max-w-[1240px] mx-auto px-6 lg:px-10 py-24 lg:py-32\" data-kid=\"1-4\" data-name=\"about section\" id=\"oficio\">\n        <div class=\"grid lg:grid-cols-12 gap-12 lg:gap-16 items-center\" data-kid=\"1-4-1\" data-name=\"about content grid\">\n            <div class=\"lg:col-span-5 reveal relative order-2 lg:order-1\" data-kid=\"1-4-1-1\" data-name=\"about image column\">\n                <div class=\"rounded-[2rem] overflow-hidden\" data-kid=\"1-4-1-1-1\" data-name=\"about image container\">\n                    <img alt=\"El oficio\" class=\"w-full h-[520px] object-cover\" data-kid=\"1-4-1-1-1-1\" data-name=\"about section image\" decoding=\"async\" loading=\"lazy\" src=\"https://images.unsplash.com/photo-1503951914875-452162b0f3f1?auto=format&w=900&q=80&fit=crop\"/>\n                </div>\n            </div>\n            <div class=\"lg:col-span-7 reveal order-1 lg:order-2\" data-kid=\"1-4-1-2\" data-name=\"about text column\">\n                <p class=\"mono-label ep-accent mb-6\" data-kid=\"1-4-1-2-1\" data-name=\"about section label\">\n                    El Oficio\n                </p>\n                <h2 class=\"font-display font-500 ep-ink text-[clamp(2.2rem,4.5vw,3.6rem)] leading-tight tracking-tight\" data-kid=\"1-4-1-2-2\" data-name=\"about section headline\">\n                    El oficio, bien hecho\n                </h2>\n                <p class=\"ep-ink-soft text-lg mt-6 max-w-lg leading-relaxed font-300\" data-kid=\"1-4-1-2-3\" data-name=\"about description text\">\n                    Compramos directo a distribuidores. Tú recibes precio de barbería y productos que aguantan el día a día en la silla.\n                </p>\n                <div class=\"mt-12 space-y-1\" data-kid=\"1-4-1-2-4\" data-name=\"features list container\">\n                    <div class=\"grid grid-cols-[auto_1fr] gap-6 items-start py-6 border-t ep-border\" data-kid=\"1-4-1-2-4-1\" data-name=\"feature item\">\n                        <span class=\"font-mono ep-accent text-lg\" data-kid=\"1-4-1-2-4-1-1\" data-name=\"feature index number\">\n                            01\n                        </span>\n                        <div data-kid=\"1-4-1-2-4-1-2\" data-name=\"feature text container\">\n                            <h3 class=\"font-display text-xl ep-ink\" data-kid=\"1-4-1-2-4-1-2-1\" data-name=\"feature title\">\n                                Calidad garantizada\n                            </h3>\n                            <p class=\"ep-ink-soft mt-2 font-300\" data-kid=\"1-4-1-2-4-1-2-2\" data-name=\"feature description\">\n                                Cada producto es probado por barberos antes de llegar a tu puerta.\n                            </p>\n                        </div>\n                    </div>\n                    <div class=\"grid grid-cols-[auto_1fr] gap-6 items-start py-6 border-t ep-border\" data-kid=\"1-4-1-2-4-2\" data-name=\"feature item\">\n                        <span class=\"font-mono ep-accent text-lg\" data-kid=\"1-4-1-2-4-2-1\" data-name=\"feature index number\">\n                            02\n                        </span>\n                        <div data-kid=\"1-4-1-2-4-2-2\" data-name=\"feature text container\">\n                            <h3 class=\"font-display text-xl ep-ink\" data-kid=\"1-4-1-2-4-2-2-1\" data-name=\"feature title\">\n                                Envío en 24 horas\n                            </h3>\n                            <p class=\"ep-ink-soft mt-2 font-300\" data-kid=\"1-4-1-2-4-2-2-2\" data-name=\"feature description\">\n                                Despachamos el mismo día en las principales ciudades del país.\n                            </p>\n                        </div>\n                    </div>\n                    <div class=\"grid grid-cols-[auto_1fr] gap-6 items-start py-6 border-t border-b ep-border\" data-kid=\"1-4-1-2-4-3\" data-name=\"feature item\">\n                        <span class=\"font-mono ep-accent text-lg\" data-kid=\"1-4-1-2-4-3-1\" data-name=\"feature index number\">\n                            03\n                        </span>\n                        <div data-kid=\"1-4-1-2-4-3-2\" data-name=\"feature text container\">\n                            <h3 class=\"font-display text-xl ep-ink\" data-kid=\"1-4-1-2-4-3-2-1\" data-name=\"feature title\">\n                                Asesoría experta\n                            </h3>\n                            <p class=\"ep-ink-soft mt-2 font-300\" data-kid=\"1-4-1-2-4-3-2-2\" data-name=\"feature description\">\n                                Te ayudamos a elegir según tu tipo de trabajo y de piel.\n                            </p>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </section>\n    <!-- ================= COLECCIÓN ================= -->\n    <section class=\"ep-bg-ink py-24 lg:py-32\" data-kid=\"1-5\" data-name=\"collection section\" id=\"coleccion\">\n        <div class=\"max-w-[1240px] mx-auto px-6 lg:px-10\" data-kid=\"1-5-1\" data-name=\"collection container\">\n            <div class=\"flex flex-col md:flex-row md:items-end justify-between gap-6 mb-16 reveal\" data-kid=\"1-5-1-1\" data-name=\"collection header\">\n                <div data-kid=\"1-5-1-1-1\" data-name=\"header text block\">\n                    <p class=\"mono-label ep-accent mb-5\" data-kid=\"1-5-1-1-1-1\" data-name=\"collection label\">\n                        Colección\n                    </p>\n                    <h2 class=\"font-display font-500 text-[clamp(2.4rem,5vw,4rem)] leading-none tracking-tight\" data-kid=\"1-5-1-1-1-2\" data-name=\"collection headline\" style=\"color:#F3EBE2;\">\n                        La colección\n                    </h2>\n                </div>\n                <p class=\"font-300 max-w-xs\" data-kid=\"1-5-1-1-2\" data-name=\"collection description\" style=\"color:#C5BEB6;\">\n                    Cuatro esenciales para trabajar y para el cuidado diario. Pide directo por WhatsApp.\n                </p>\n            </div>\n            <div class=\"grid lg:grid-cols-12 gap-6\" data-kid=\"1-5-1-2\" data-name=\"products grid\">\n                <!-- Featured large -->\n                <article class=\"prod-panel reveal lg:col-span-6 ep-surface rounded-[2rem] p-8 flex flex-col\" data-kid=\"1-5-1-2-1\" data-name=\"featured product card\">\n                    <div class=\"flex items-center justify-between\" data-kid=\"1-5-1-2-1-1\" data-name=\"product card meta\">\n                        <span class=\"mono-label ep-ink-soft\" data-kid=\"1-5-1-2-1-1-1\" data-name=\"product label\">\n                            Máquina profesional\n                        </span>\n                        <span class=\"mono-label ep-accent\" data-kid=\"1-5-1-2-1-1-2\" data-name=\"featured badge\">\n                            Destacado\n                        </span>\n                    </div>\n                    <div class=\"bg-white rounded-[1.5rem] my-6 grow flex items-center justify-center overflow-hidden min-h-[420px]\" data-kid=\"1-5-1-2-1-2\" data-name=\"product image container\">\n                        <img alt=\"Máquina Wahl\" class=\"w-full h-full object-cover\" data-kid=\"1-5-1-2-1-2-1\" data-name=\"product image\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/products/maquina-wahl.png\"/>\n                    </div>\n                    <div class=\"flex items-end justify-between\" data-kid=\"1-5-1-2-1-3\" data-name=\"product card footer\">\n                        <div data-kid=\"1-5-1-2-1-3-1\" data-name=\"product title info\">\n                            <h3 class=\"font-display text-3xl ep-ink\" data-kid=\"1-5-1-2-1-3-1-1\" data-name=\"product name\">\n                                Máquina Wahl\n                            </h3>\n                            <p class=\"mono-label ep-accent mt-2\" data-kid=\"1-5-1-2-1-3-1-2\" data-name=\"product price\">\n                                Desde $85\n                            </p>\n                        </div>\n                        <a class=\"link-underline font-mono text-sm ep-ink\" data-kid=\"1-5-1-2-1-3-2\" data-name=\"whatsapp order link\" href=\"#contacto\">\n                            Pedir por WhatsApp →\n                        </a>\n                    </div>\n                </article>\n                <!-- Stacked list of 3 -->\n                <div class=\"lg:col-span-6 grid gap-6\" data-kid=\"1-5-1-2-2\" data-name=\"product list container\">\n                    <article class=\"prod-panel reveal ep-surface rounded-[2rem] p-6 grid grid-cols-[130px_1fr] sm:grid-cols-[160px_1fr] gap-6 items-center\" data-kid=\"1-5-1-2-2-1\" data-name=\"product card\">\n                        <div class=\"bg-white rounded-2xl overflow-hidden h-32 flex items-center justify-center\" data-kid=\"1-5-1-2-2-1-1\" data-name=\"product image container\">\n                            <img alt=\"Cera Rolda\" class=\"w-full h-full object-cover\" data-kid=\"1-5-1-2-2-1-1-1\" data-name=\"product image\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/products/cera-rolda.png\"/>\n                        </div>\n                        <div data-kid=\"1-5-1-2-2-1-2\" data-name=\"product info\">\n                            <span class=\"mono-label ep-ink-soft\" data-kid=\"1-5-1-2-2-1-2-1\" data-name=\"product label\">\n                                Cera de peinado mate\n                            </span>\n                            <h3 class=\"font-display text-2xl ep-ink mt-1\" data-kid=\"1-5-1-2-2-1-2-2\" data-name=\"product name\">\n                                Cera Rolda\n                            </h3>\n                            <div class=\"flex items-center justify-between mt-2\" data-kid=\"1-5-1-2-2-1-2-3\" data-name=\"product footer\">\n                                <span class=\"mono-label ep-accent\" data-kid=\"1-5-1-2-2-1-2-3-1\" data-name=\"product price\">\n                                    $12\n                                </span>\n                                <a class=\"link-underline font-mono text-xs ep-ink\" data-kid=\"1-5-1-2-2-1-2-3-2\" data-name=\"whatsapp order link\" href=\"#contacto\">\n                                    Pedir →\n                                </a>\n                            </div>\n                        </div>\n                    </article>\n                    <article class=\"prod-panel reveal ep-surface rounded-[2rem] p-6 grid grid-cols-[130px_1fr] sm:grid-cols-[160px_1fr] gap-6 items-center\" data-kid=\"1-5-1-2-2-2\" data-name=\"product card\">\n                        <div class=\"bg-white rounded-2xl overflow-hidden h-32 flex items-center justify-center\" data-kid=\"1-5-1-2-2-2-1\" data-name=\"product image container\">\n                            <img alt=\"Minoxidil\" class=\"w-full h-full object-cover\" data-kid=\"1-5-1-2-2-2-1-1\" data-name=\"product image\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/products/minoxidil.png\"/>\n                        </div>\n                        <div data-kid=\"1-5-1-2-2-2-2\" data-name=\"product info\">\n                            <span class=\"mono-label ep-ink-soft\" data-kid=\"1-5-1-2-2-2-2-1\" data-name=\"product label\">\n                                Crecimiento de barba\n                            </span>\n                            <h3 class=\"font-display text-2xl ep-ink mt-1\" data-kid=\"1-5-1-2-2-2-2-2\" data-name=\"product name\">\n                                Minoxidil\n                            </h3>\n                            <div class=\"flex items-center justify-between mt-2\" data-kid=\"1-5-1-2-2-2-2-3\" data-name=\"product footer\">\n                                <span class=\"mono-label ep-accent\" data-kid=\"1-5-1-2-2-2-2-3-1\" data-name=\"product price\">\n                                    $18\n                                </span>\n                                <a class=\"link-underline font-mono text-xs ep-ink\" data-kid=\"1-5-1-2-2-2-2-3-2\" data-name=\"whatsapp order link\" href=\"#contacto\">\n                                    Pedir →\n                                </a>\n                            </div>\n                        </div>\n                    </article>\n                    <article class=\"prod-panel reveal ep-surface rounded-[2rem] p-6 grid grid-cols-[130px_1fr] sm:grid-cols-[160px_1fr] gap-6 items-center\" data-kid=\"1-5-1-2-2-3\" data-name=\"product card\">\n                        <div class=\"bg-white rounded-2xl overflow-hidden h-32 flex items-center justify-center\" data-kid=\"1-5-1-2-2-3-1\" data-name=\"product image container\">\n                            <img alt=\"Navaja con hojillas\" class=\"w-full h-full object-cover\" data-kid=\"1-5-1-2-2-3-1-1\" data-name=\"product image\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/products/navaja-hojillas.png\"/>\n                        </div>\n                        <div data-kid=\"1-5-1-2-2-3-2\" data-name=\"product info\">\n                            <span class=\"mono-label ep-ink-soft\" data-kid=\"1-5-1-2-2-3-2-1\" data-name=\"product label\">\n                                Navaja con hojillas\n                            </span>\n                            <h3 class=\"font-display text-2xl ep-ink mt-1\" data-kid=\"1-5-1-2-2-3-2-2\" data-name=\"product name\">\n                                Navaja + Hojillas\n                            </h3>\n                            <div class=\"flex items-center justify-between mt-2\" data-kid=\"1-5-1-2-2-3-2-3\" data-name=\"product footer\">\n                                <span class=\"mono-label ep-accent\" data-kid=\"1-5-1-2-2-3-2-3-1\" data-name=\"product price\">\n                                    $9\n                                </span>\n                                <a class=\"link-underline font-mono text-xs ep-ink\" data-kid=\"1-5-1-2-2-3-2-3-2\" data-name=\"whatsapp order link\" href=\"#contacto\">\n                                    Pedir →\n                                </a>\n                            </div>\n                        </div>\n                    </article>\n                </div>\n            </div>\n        </div>\n    </section>\n    <!-- ================= TESTIMONIOS ================= -->\n    <section class=\"max-w-[1240px] mx-auto px-6 lg:px-10 py-24 lg:py-32\" data-kid=\"1-6\" data-name=\"testimonials section\" id=\"testimonios\">\n        <div class=\"reveal mb-16\" data-kid=\"1-6-1\" data-name=\"testimonials header\">\n            <p class=\"mono-label ep-accent mb-5\" data-kid=\"1-6-1-1\" data-name=\"testimonials label\">\n                Testimonios\n            </p>\n            <h2 class=\"font-display font-500 ep-ink text-[clamp(2.2rem,4.5vw,3.6rem)] tracking-tight max-w-2xl leading-tight\" data-kid=\"1-6-1-2\" data-name=\"testimonials headline\">\n                Lo que dicen los barberos\n            </h2>\n        </div>\n        <div class=\"grid md:grid-cols-12 gap-8\" data-kid=\"1-6-2\" data-name=\"testimonials grid\">\n            <figure class=\"reveal md:col-span-7 border-t ep-border pt-8\" data-kid=\"1-6-2-1\" data-name=\"testimonial card\">\n                <blockquote class=\"font-display italic font-400 text-2xl lg:text-3xl ep-ink leading-snug\" data-kid=\"1-6-2-1-1\" data-name=\"testimonial quote\">\n                    “La máquina Wahl que pedí llegó al día siguiente. Corta parejo y no se calienta ni en un día full de clientes.”\n                </blockquote>\n                <figcaption class=\"mono-label ep-ink-soft mt-6\" data-kid=\"1-6-2-1-2\" data-name=\"testimonial attribution\">\n                    Ricardo M. — Barbero, Caracas\n                </figcaption>\n            </figure>\n            <figure class=\"reveal md:col-span-5 border-t ep-border pt-8\" data-kid=\"1-6-2-2\" data-name=\"testimonial card\">\n                <blockquote class=\"font-display italic font-400 text-xl ep-ink leading-snug\" data-kid=\"1-6-2-2-1\" data-name=\"testimonial quote\">\n                    “Precios de verdad de barbería. Ya les compro toda la cera para el local.”\n                </blockquote>\n                <figcaption class=\"mono-label ep-ink-soft mt-6\" data-kid=\"1-6-2-2-2\" data-name=\"testimonial attribution\">\n                    Jesús O. — Barbero, Maracaibo\n                </figcaption>\n            </figure>\n            <figure class=\"reveal md:col-span-5 border-t ep-border pt-8\" data-kid=\"1-6-2-3\" data-name=\"testimonial card\">\n                <blockquote class=\"font-display italic font-400 text-xl ep-ink leading-snug\" data-kid=\"1-6-2-3-1\" data-name=\"testimonial quote\">\n                    “Me asesoraron con el minoxidil y con la navaja. Se nota que saben del oficio.”\n                </blockquote>\n                <figcaption class=\"mono-label ep-ink-soft mt-6\" data-kid=\"1-6-2-3-2\" data-name=\"testimonial attribution\">\n                    Andrés P. — Barbero, Valencia\n                </figcaption>\n            </figure>\n            <figure class=\"reveal md:col-span-7 border-t ep-border pt-8\" data-kid=\"1-6-2-4\" data-name=\"testimonial card\">\n                <blockquote class=\"font-display italic font-400 text-2xl lg:text-3xl ep-ink leading-snug\" data-kid=\"1-6-2-4-1\" data-name=\"testimonial quote\">\n                    “Atención directa por WhatsApp, envío rápido y productos que duran. No pido nada más.”\n                </blockquote>\n                <figcaption class=\"mono-label ep-ink-soft mt-6\" data-kid=\"1-6-2-4-2\" data-name=\"testimonial attribution\">\n                    Luis G. — Barbero, Barquisimeto\n                </figcaption>\n            </figure>\n        </div>\n    </section>\n    <!-- ================= CONTACTO ================= -->\n    <section class=\"py-24 lg:py-32\" data-kid=\"1-7\" data-name=\"contact section\" id=\"contacto\" style=\"background:linear-gradient(180deg,#F3EBE2, #ecdfd2);\">\n        <div class=\"max-w-[1240px] mx-auto px-6 lg:px-10\" data-kid=\"1-7-1\" data-name=\"contact container\">\n            <div class=\"grid lg:grid-cols-2 gap-14 lg:gap-20 items-center\" data-kid=\"1-7-1-1\" data-name=\"contact grid\">\n                <div class=\"reveal\" data-kid=\"1-7-1-1-1\" data-name=\"contact info column\">\n                    <p class=\"mono-label ep-accent mb-6\" data-kid=\"1-7-1-1-1-1\" data-name=\"contact label\">\n                        Contacto\n                    </p>\n                    <h2 class=\"font-display font-500 ep-ink text-[clamp(2.6rem,5.5vw,4.4rem)] leading-none tracking-tight\" data-kid=\"1-7-1-1-1-2\" data-name=\"contact headline\">\n                        Hablemos\n                    </h2>\n                    <p class=\"ep-ink-soft text-lg mt-7 max-w-md leading-relaxed font-300\" data-kid=\"1-7-1-1-1-3\" data-name=\"contact description\">\n                        Escríbenos y arma tu pedido por WhatsApp. Te asesoramos, confirmamos disponibilidad y despachamos en 24 horas.\n                    </p>\n                    <div class=\"mt-10 flex items-center gap-4\" data-kid=\"1-7-1-1-1-4\" data-name=\"contact details\">\n                        <span class=\"w-12 h-12 rounded-full ep-bg-accent flex items-center justify-center font-mono ep-ink\" data-kid=\"1-7-1-1-1-4-1\" data-name=\"contact icon container\">\n                            EP\n                        </span>\n                        <div data-kid=\"1-7-1-1-1-4-2\" data-name=\"contact details text\">\n                            <p class=\"font-mono text-sm ep-ink\" data-kid=\"1-7-1-1-1-4-2-1\" data-name=\"phone number\">\n                                +58 412 000 0000\n                            </p>\n                            <p class=\"mono-label ep-ink-soft mt-1\" data-kid=\"1-7-1-1-1-4-2-2\" data-name=\"business hours\">\n                                Lun a Sáb · 9am – 6pm\n                            </p>\n                        </div>\n                    </div>\n                </div>\n                <form class=\"reveal border rounded-[2rem] p-8 lg:p-10 space-y-6\" data-kid=\"1-7-1-1-2\" data-name=\"contact form\" style=\"background:rgba(255,255,255,0.55);border-color:#C5BEB6;\">\n                    <div data-kid=\"1-7-1-1-2-1\" data-name=\"form field group\">\n                        <label class=\"mono-label ep-ink-soft block mb-3\" data-kid=\"1-7-1-1-2-1-1\" data-name=\"label\">\n                            Nombre\n                        </label>\n                        <input class=\"field w-full rounded-xl px-4 py-3.5 ep-ink font-body\" data-kid=\"1-7-1-1-2-1-2\" data-name=\"input field\" placeholder=\"Tu nombre\" type=\"text\"/>\n                    </div>\n                    <div data-kid=\"1-7-1-1-2-2\" data-name=\"form field group\">\n                        <label class=\"mono-label ep-ink-soft block mb-3\" data-kid=\"1-7-1-1-2-2-1\" data-name=\"label\">\n                            WhatsApp\n                        </label>\n                        <input class=\"field w-full rounded-xl px-4 py-3.5 ep-ink font-body\" data-kid=\"1-7-1-1-2-2-2\" data-name=\"input field\" placeholder=\"+58 ...\" type=\"tel\"/>\n                    </div>\n                    <div data-kid=\"1-7-1-1-2-3\" data-name=\"form field group\">\n                        <label class=\"mono-label ep-ink-soft block mb-3\" data-kid=\"1-7-1-1-2-3-1\" data-name=\"label\">\n                            Mensaje\n                        </label>\n                        <textarea class=\"field w-full rounded-xl px-4 py-3.5 ep-ink font-body resize-none\" data-kid=\"1-7-1-1-2-3-2\" data-name=\"textarea field\" placeholder=\"¿Qué productos te interesan?\" rows=\"4\"></textarea>\n                    </div>\n                    <button class=\"btn-accent mono-label w-full py-4 rounded-full\" data-kid=\"1-7-1-1-2-4\" data-name=\"submit button\" type=\"button\">\n                        Enviar Mensaje\n                    </button>\n                </form>\n            </div>\n        </div>\n    </section>\n    <!-- ================= FOOTER ================= -->\n    <footer class=\"ep-surface border-t ep-border\" data-kid=\"1-8\" data-name=\"footer\">\n        <div class=\"max-w-[1240px] mx-auto px-6 lg:px-10 py-14 flex flex-col md:flex-row items-center justify-between gap-6\" data-kid=\"1-8-1\" data-name=\"footer content\">\n            <a class=\"font-display text-2xl font-600 ep-ink\" data-kid=\"1-8-1-1\" data-name=\"footer brand link\" href=\"#\">\n                EduardoPro\n            </a>\n            <div class=\"flex items-center gap-8 mono-label ep-ink-soft\" data-kid=\"1-8-1-2\" data-name=\"footer navigation links\">\n                <a class=\"hover:ep-accent transition-colors\" data-kid=\"1-8-1-2-1\" data-name=\"navigation link\" href=\"#oficio\">\n                    El Oficio\n                </a>\n                <a class=\"hover:ep-accent transition-colors\" data-kid=\"1-8-1-2-2\" data-name=\"navigation link\" href=\"#coleccion\">\n                    Colección\n                </a>\n                <a class=\"hover:ep-accent transition-colors\" data-kid=\"1-8-1-2-3\" data-name=\"navigation link\" href=\"#contacto\">\n                    Contacto\n                </a>\n            </div>\n            <p class=\"mono-label ep-ink-soft text-center\" data-kid=\"1-8-1-3\" data-name=\"copyright text\">\n                © 2026 EduardoPro — Todos los derechos reservados\n            </p>\n        </div>\n    </footer>\n</div>\n<script>\n    const io = new IntersectionObserver((entries) => {\n    entries.forEach((e, i) => {\n      if (e.isIntersecting) {\n        e.target.style.transitionDelay = (Math.min(i,4) * 90) + 'ms';\n        e.target.classList.add('in');\n        io.unobserve(e.target);\n      }\n    });\n  }, { threshold: 0.08, rootMargin: '0px 0px -5% 0px' });\n  document.querySelectorAll('.reveal').forEach(el => io.observe(el));\n\n  // Safety fallback: ensure all content is visible even if observer doesn't fire\n  window.addEventListener('load', () => {\n    setTimeout(() => {\n      document.querySelectorAll('.reveal:not(.in)').forEach(el => el.classList.add('in'));\n    }, 1600);\n  });\n</script>\n",
