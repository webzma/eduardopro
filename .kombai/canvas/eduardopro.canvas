s=\"ff-serif text-[24px] mb-3\" data-kid=\"1-5-1-2-3-2-2\" data-name=\"product card 3 name\">\n                            Minoxidil\n                        </h3>\n                        <div class=\"mt-auto flex items-center justify-between pt-4 border-t border-[var(--hair)]\" data-kid=\"1-5-1-2-3-2-3\" data-name=\"product card 3 price container\">\n                            <span class=\"ff-serif text-[var(--accent)] text-[26px]\" data-kid=\"1-5-1-2-3-2-3-1\" data-name=\"product card 3 price\">\n                                $18\n                            </span>\n                            <a class=\"wa-link ff-mono text-[12px] tracking-[0.16em] text-[var(--cream)] transition-colors\" data-kid=\"1-5-1-2-3-2-3-2\" data-name=\"product card 3 link\" href=\"#contacto\">\n                                PEDIR →\n                            </a>\n                        </div>\n                    </div>\n                </div>\n                <div class=\"prod-card reveal group border border-[var(--hair)] bg-[var(--bg)] transition-colors duration-500 flex flex-col\" data-dynamic=\"true\" data-kid=\"1-5-1-2-4\" data-name=\"product card 4\" data-reason=\"class toggled by intersection observer to reveal content\">\n                    <div class=\"overflow-hidden bg-[#211d19]\" data-kid=\"1-5-1-2-4-1\" data-name=\"product card 4 image container\">\n                        <img alt=\"Navaja + Hojillas\" class=\"prod-img w-full h-56 object-cover\" data-kid=\"1-5-1-2-4-1-1\" data-name=\"product card 4 image\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/products/navaja-hojillas.png\"/>\n                    </div>\n                    <div class=\"p-6 flex flex-col flex-1\" data-kid=\"1-5-1-2-4-2\" data-name=\"product card 4 info container\">\n                        <p class=\"ff-mono text-[10px] tracking-[0.24em] text-[var(--ink)] mb-2\" data-kid=\"1-5-1-2-4-2-1\" data-name=\"product card 4 category\">\n                            NAVAJA CON HOJILLAS\n                        </p>\n                        <h3 class=\"ff-serif text-[24px] mb-3\" data-kid=\"1-5-1-2-4-2-2\" data-name=\"product card 4 name\">\n                            Navaja + Hojillas\n                        </h3>\n                        <div class=\"mt-auto flex items-center justify-between pt-4 border-t border-[var(--hair)]\" data-kid=\"1-5-1-2-4-2-3\" data-name=\"product card 4 price container\">\n                            <span class=\"ff-serif text-[var(--accent)] text-[26px]\" data-kid=\"1-5-1-2-4-2-3-1\" data-name=\"product card 4 price\">\n                                $9\n                            </span>\n                            <a class=\"wa-link ff-mono text-[12px] tracking-[0.16em] text-[var(--cream)] transition-colors\" data-kid=\"1-5-1-2-4-2-3-2\" data-name=\"product card 4 link\" href=\"#contacto\">\n                                PEDIR →\n                            </a>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </section>\n    <!-- TESTIMONIOS -->\n    <section class=\"bg-[var(--bg)] py-24 md:py-32\" data-kid=\"1-6\" data-name=\"testimonials section\" id=\"testimonios\">\n        <div class=\"max-w-[1280px] mx-auto px-6 md:px-10\" data-kid=\"1-6-1\" data-name=\"testimonials content container\">\n            <div class=\"reveal mb-16 max-w-2xl\" data-dynamic=\"true\" data-kid=\"1-6-1-1\" data-name=\"testimonials header group\" data-reason=\"class toggled by intersection observer to reveal content\">\n                <p class=\"ff-mono text-[11px] tracking-[0.3em] text-[var(--accent)] mb-5\" data-kid=\"1-6-1-1-1\" data-name=\"testimonials sub-headline\">\n                    TESTIMONIOS\n                </p>\n                <h2 class=\"ff-serif font-bold text-[42px] md:text-[58px] leading-[1.02] tracking-tight\" data-kid=\"1-6-1-1-2\" data-name=\"testimonials main headline\">\n                    Lo dicen los que cortan\n                </h2>\n            </div>\n            <div class=\"grid md:grid-cols-3 gap-px bg-[var(--hair)] border border-[var(--hair)]\" data-kid=\"1-6-1-2\" data-name=\"testimonials grid\">\n                <div class=\"reveal bg-[var(--bg)] p-9 md:p-11\" data-dynamic=\"true\" data-kid=\"1-6-1-2-1\" data-name=\"testimonial card 1\" data-reason=\"class toggled by intersection observer to reveal content\">\n                    <span class=\"ff-serif text-[var(--accent)] text-[60px] leading-none block mb-4\" data-kid=\"1-6-1-2-1-1\" data-name=\"testimonial 1 quote icon\">\n                        “\n                    </span>\n                    <p class=\"ff-serif italic text-[22px] md:text-[24px] leading-snug text-[var(--cream)]\" data-kid=\"1-6-1-2-1-2\" data-name=\"testimonial 1 quote text\">\n                        Herramientas de verdad. La Wahl que compré aquí lleva dos años sin fallar en plena jornada.\n                    </p>\n                    <p class=\"ff-mono text-[10px] tracking-[0.24em] text-[var(--ink)] mt-8\" data-kid=\"1-6-1-2-1-3\" data-name=\"testimonial 1 author info\">\n                        JOSÉ R. — BARBERO, CARACAS\n                    </p>\n                </div>\n                <div class=\"reveal bg-[var(--bg)] p-9 md:p-11\" data-dynamic=\"true\" data-kid=\"1-6-1-2-2\" data-name=\"testimonial card 2\" data-reason=\"class toggled by intersection observer to reveal content\">\n                    <span class=\"ff-serif text-[var(--accent)] text-[60px] leading-none block mb-4\" data-kid=\"1-6-1-2-2-1\" data-name=\"testimonial 2 quote icon\">\n                        “\n                    </span>\n                    <p class=\"ff-serif italic text-[22px] md:text-[24px] leading-snug text-[var(--cream)]\" data-kid=\"1-6-1-2-2-2\" data-name=\"testimonial 2 quote text\">\n                        Precio de barbería real y despacho rápido. Mis clientes notan la diferencia en el acabado.\n                    </p>\n                    <p class=\"ff-mono text-[10px] tracking-[0.24em] text-[var(--ink)] mt-8\" data-kid=\"1-6-1-2-2-3\" data-name=\"testimonial 2 author info\">\n                        MIGUEL A. — BARBERO, VALENCIA\n                    </p>\n                </div>\n                <div class=\"reveal bg-[var(--bg)] p-9 md:p-11\" data-dynamic=\"true\" data-kid=\"1-6-1-2-3\" data-name=\"testimonial card 3\" data-reason=\"class toggled by intersection observer to reveal content\">\n                    <span class=\"ff-serif text-[var(--accent)] text-[60px] leading-none block mb-4\" data-kid=\"1-6-1-2-3-1\" data-name=\"testimonial 3 quote icon\">\n                        “\n                    </span>\n                    <p class=\"ff-serif italic text-[22px] md:text-[24px] leading-snug text-[var(--cream)]\" data-kid=\"1-6-1-2-3-2\" data-name=\"testimonial 3 quote text\">\n                        La asesoría es lo mejor. Me guiaron con la navaja correcta y ahora es mi favorita en la silla.\n                    </p>\n                    <p class=\"ff-mono text-[10px] tracking-[0.24em] text-[var(--ink)] mt-8\" data-kid=\"1-6-1-2-3-3\" data-name=\"testimonial 3 author info\">\n                        CARLOS D. — BARBERO, MARACAIBO\n                    </p>\n                </div>\n            </div>\n        </div>\n    </section>\n    <!-- CONTACTO -->\n    <section class=\"bg-[var(--cream)] text-[#171412] py-24 md:py-32\" data-kid=\"1-7\" data-name=\"contact section\" id=\"contacto\">\n        <div class=\"max-w-[1280px] mx-auto px-6 md:px-10 grid lg:grid-cols-2 gap-14 lg:gap-24 items-center\" data-kid=\"1-7-1\" data-name=\"contact content container\">\n            <div class=\"reveal\" data-dynamic=\"true\" data-kid=\"1-7-1-1\" data-name=\"contact info group\" data-reason=\"class toggled by intersection observer to reveal content\">\n                <p class=\"ff-mono text-[11px] tracking-[0.3em] text-[var(--accent)] mb-5\" data-kid=\"1-7-1-1-1\" data-name=\"contact sub-headline\">\n                    CONTACTO\n                </p>\n                <h2 class=\"ff-serif font-bold text-[56px] md:text-[80px] leading-none tracking-tight\" data-kid=\"1-7-1-1-2\" data-name=\"contact main headline\">\n                    Hablemos\n                </h2>\n                <p class=\"mt-7 text-[#4b453d] text-[17px] leading-relaxed max-w-md\" data-kid=\"1-7-1-1-3\" data-name=\"contact description\">\n                    Haz tu pedido directo por WhatsApp o déjanos un mensaje. Te respondemos en minutos y coordinamos el envío a todo el país.\n                </p>\n                <div class=\"mt-10 flex items-center gap-4 ff-mono text-[12px] tracking-[0.2em] text-[#171412]\" data-kid=\"1-7-1-1-4\" data-name=\"contact status indicator container\">\n                    <span class=\"w-10 h-px bg-[#171412]/30\" data-kid=\"1-7-1-1-4-1\" data-name=\"contact decorative line\">\n                    </span>\n                    RESPUESTA EN MINUTOS\n                </div>\n            </div>\n            <form class=\"reveal space-y-5\" data-dynamic=\"true\" data-kid=\"1-7-1-2\" data-name=\"contact form\" data-reason=\"class toggled by intersection observer to reveal content\" onsubmit=\"return false;\">\n                <div data-kid=\"1-7-1-2-1\" data-name=\"form name input group\">\n                    <label class=\"ff-mono text-[11px] tracking-[0.22em] text-[#6b6459] block mb-2\" data-kid=\"1-7-1-2-1-1\" data-name=\"name label\">\n                        NOMBRE\n                    </label>\n                    <input class=\"w-full bg-transparent border-b border-[#171412]/45 py-3 text-[16px] focus:outline-hidden focus:border-[var(--accent)] transition-colors placeholder:text-[#171412]/50\" data-kid=\"1-7-1-2-1-2\" data-name=\"name input field\" placeholder=\"Tu nombre\" type=\"text\"/>\n                </div>\n                <div data-kid=\"1-7-1-2-2\" data-name=\"form whatsapp input group\">\n                    <label class=\"ff-mono text-[11px] tracking-[0.22em] text-[#6b6459] block mb-2\" data-kid=\"1-7-1-2-2-1\" data-name=\"whatsapp label\">\n                        WHATSAPP\n                    </label>\n                    <input class=\"w-full bg-transparent border-b border-[#171412]/45 py-3 text-[16px] focus:outline-hidden focus:border-[var(--accent)] transition-colors placeholder:text-[#171412]/50\" data-kid=\"1-7-1-2-2-2\" data-name=\"whatsapp input field\" placeholder=\"+58 ...\" type=\"tel\"/>\n                </div>\n                <div data-kid=\"1-7-1-2-3\" data-name=\"form message input group\">\n                    <label class=\"ff-mono text-[11px] tracking-[0.22em] text-[#6b6459] block mb-2\" data-kid=\"1-7-1-2-3-1\" data-name=\"message label\">\n                        MENSAJE\n                    </label>\n                    <textarea class=\"w-full bg-transparent border-b border-[#171412]/45 py-3 text-[16px] focus:outline-hidden focus:border-[var(--accent)] transition-colors resize-none placeholder:text-[#171412]/50\" data-kid=\"1-7-1-2-3-2\" data-name=\"message text area\" placeholder=\"¿Qué necesitas?\" rows=\"3\"></textarea>\n                </div>\n                <button class=\"btn-accent ff-mono text-[12px] tracking-[0.2em] bg-[var(--accent)] text-[#171412] px-9 py-4 font-medium w-full sm:w-auto transition-colors\" data-kid=\"1-7-1-2-4\" data-name=\"send message button\" type=\"submit\">\n                    ENVIAR MENSAJE\n                </button>\n            </form>\n        </div>\n    </section>\n    <!-- FOOTER -->\n    <footer class=\"bg-[var(--bg)] pt-16 pb-10\" data-kid=\"1-8\" data-name=\"footer\">\n        <div class=\"max-w-[1280px] mx-auto px-6 md:px-10\" data-kid=\"1-8-1\" data-name=\"footer inner wrapper\">\n            <div class=\"border-t border-[var(--hair)] pt-10 flex flex-col md:flex-row items-start md:items-center justify-between gap-6\" data-kid=\"1-8-1-1\" data-name=\"footer top row\">\n                <a class=\"ff-serif text-[34px] font-bold text-[var(--cream)]\" data-kid=\"1-8-1-1-1\" data-name=\"footer brand link\" href=\"#\">\n                    EduardoPro\n                </a>\n                <div class=\"flex flex-col md:flex-row md:items-center gap-4 md:gap-9 ff-mono text-[11px] tracking-[0.22em] text-[var(--ink)]\" data-kid=\"1-8-1-1-2\" data-name=\"footer navigation links\">\n                    <a class=\"hover:text-[var(--accent)] transition-colors\" data-kid=\"1-8-1-1-2-1\" data-name=\"footer link 1\" href=\"#oficio\">\n                        EL OFICIO\n                    </a>\n                    <a class=\"hover:text-[var(--accent)] transition-colors\" data-kid=\"1-8-1-1-2-2\" data-name=\"footer link 2\" href=\"#coleccion\">\n                        COLECCIÓN\n                    </a>\n                    <a class=\"hover:text-[var(--accent)] transition-colors\" data-kid=\"1-8-1-1-2-3\" data-name=\"footer link 3\" href=\"#contacto\">\n                        CONTACTO\n                    </a>\n                </div>\n            </div>\n            <p class=\"ff-mono text-[10px] tracking-[0.24em] text-[var(--ink)] mt-10\" data-kid=\"1-8-1-2\" data-name=\"footer copyright text\">\n                © 2026 EDUARDOPRO — TODOS LOS DERECHOS RESERVADOS\n            </p>\n        </div>\n    </footer>\n</div>\n<script>\n    (function(){\n    const els = document.querySelectorAll('#ep-root .reveal');\n    const io = new IntersectionObserver((entries)=>{\n      entries.forEach((e, i)=>{\n        if(e.isIntersecting){\n          e.target.style.transitionDelay = (e.target.dataset.d || (i%4)*90) + 'ms';\n          e.target.classList.add('in');\n          io.unobserve(e.target);\n        }\n      });\n    }, { threshold: 0.12, rootMargin: '0px 0px -6% 0px' });\n    els.forEach(el=>io.observe(el));\n    // Safety fallback: never leave content hidden\n    setTimeout(function(){\n      document.querySelectorAll('#ep-root .reveal:not(.in)').forEach(function(el){ el.classList.add('in'); });\n    }, 2500);\n  })();\n</script>\n",
